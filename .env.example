# ============================================================
# MysticDAO Frontend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your real values.
# Vite only exposes env vars prefixed with VITE_ to the client.

# --- Google Analytics 4 ---
# Replace with your real GA4 Measurement ID from Google Analytics dashboard
# https://analytics.google.com/ → Admin → Data Streams → Web
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- API Endpoints ---
# VITE_API_BASE_URL=https://api.mysticdao.xyz

# --- Feature Flags ---
# VITE_ENABLE_DEBUG=false
